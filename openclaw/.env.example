# Stark Voice Proxy — Environment Variables
# Copy to proxy/.env or export before running

# Port the proxy listens on
PORT=8013

# Backend endpoint (OpenClaw gateway or any OpenAI-compatible URL)
OPENCLAW_URL=http://127.0.0.1:18789/v1/chat/completions

# Auth token for the backend
OPENCLAW_TOKEN=your-gateway-token

# OpenClaw agent ID to route requests to
OPENCLAW_AGENT=voice
